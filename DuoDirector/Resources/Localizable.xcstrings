    },
    "Dual-cam at 4K exceeds this device's camera bandwidth. Using 1080p30.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dual-Cam en 4K supera el ancho de banda de la cámara de este dispositivo. Se usará 1080p30."
          }
        }
      }
    },
    "Dual-Cam is capped at 30fps.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dual-Cam está limitado a 30 fps."
          }
        }
      }
    },
    "Dual-Cam is unavailable: this device doesn't report AVCaptureMultiCamSession support.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dual-Cam no está disponible: este dispositivo no admite AVCaptureMultiCamSession."
          }
        }
      }
    },
    "Dual-Cam Podcast needs MultiCam support, which this device doesn't report.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pódcast Dual-Cam necesita compatibilidad MultiCam, que este dispositivo no indica."
          }
        }
      }
    },
    "Dual-Cam uses the Fusion Main camera (1× / 2×).": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dual-Cam usa la cámara principal Fusion (1× / 2×)."
