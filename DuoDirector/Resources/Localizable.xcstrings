    "A composite is already rendering.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se está renderizando una composición."
          }
        }
      }
    },
    "A producer on another iPhone or iPad can start and stop takes, drop markers, rate takes and drive the prompter. You approve every connection. Nothing is sent over the internet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un productor en otro iPhone o iPad puede iniciar y detener tomas, añadir marcadores, valorar tomas y controlar el teleprompter. Tú apruebas cada conexión. No se envía nada por internet."
          }
        }
      }
    },
    "A studio for iPhone Duo: shoot with the rear camera while the cover display shows you the shot.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estudio para iPhone Duo: graba con la cámara trasera mientras la pantalla exterior te muestra el plano."
          }
        }
      }
    },
